# ─────────────────────────────────────────────────────
# RegWatch — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ─── Database ────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://regwatch:regwatch@localhost:5432/regwatch

# Supabase (replace with your project credentials)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Notifications ───────────────────────────────────
# SendGrid
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=regwatch@yourdomain.com
SENDGRID_FROM_NAME=RegWatch by AuditChain
NEWSLETTER_LIST_ID=  # SendGrid contact list ID for subscriber newsletter

# Team email recipients (JSON array)
TEAM_EMAIL_RECIPIENTS=["team@yourdomain.com", "cto@yourdomain.com"]

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#regulatory-alerts

# ─── LinkedIn (optional) ─────────────────────────────
LINKEDIN_ACCESS_TOKEN=

# ─── Scheduler ───────────────────────────────────────
SCRAPE_HOUR=6
SCRAPE_MINUTE=0
DIGEST_HOUR=8
DIGEST_MINUTE=0
LINKEDIN_POST_DAY=0      # 0=Monday
LINKEDIN_POST_HOUR=9
NEWSLETTER_SEND_DAY=1    # 1st of each month

# ─── App ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
