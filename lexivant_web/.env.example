# ─────────────────────────────────────────────────────────────
# Lexivant Watch — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ─── Database ─────────────────────────────────────────────────
# Local PostgreSQL (docker-compose)
DATABASE_URL=postgresql+asyncpg://lexivant:lexivant@localhost:5432/lexivant

# Supabase (Transaction pooler — use this for serverless/Vercel)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Notifications ────────────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=watch@lexivant.ai
SENDGRID_FROM_NAME=Lexivant Watch
TEAM_EMAIL_RECIPIENTS=["team@lexivant.ai"]
NEWSLETTER_LIST_ID=

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#regulatory-alerts

# ─── Scheduler ───────────────────────────────────────────────
SCRAPE_HOUR=6
SCRAPE_MINUTE=0
DIGEST_HOUR=8
DIGEST_MINUTE=0
LINKEDIN_POST_DAY=0
LINKEDIN_POST_HOUR=9

# ─── Vercel ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── App ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
