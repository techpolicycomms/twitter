{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "app/main.py" }
  ],
  "env": {
    "APP_ENV": "production"
  },
  "crons": [
    { "path": "/api/cron/scrape",     "schedule": "0 6 * * *" },
    { "path": "/api/cron/digest",     "schedule": "0 8 * * *" },
    { "path": "/api/cron/linkedin",   "schedule": "0 9 * * 1" },
    { "path": "/api/cron/newsletter", "schedule": "0 9 1 * *" }
  ]
}
