# =============================================================================
# AuditChain Content Engine — Environment Variables
# =============================================================================

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://auditchain:secret@localhost:5432/content_engine
SYNC_DATABASE_URL=postgresql+psycopg2://auditchain:secret@localhost:5432/content_engine

# App settings
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=false
SECRET_KEY=change-me-in-production

# Buffer API (for social scheduling export)
BUFFER_ACCESS_TOKEN=your-buffer-token
BUFFER_PROFILE_IDS_LINKEDIN=your-linkedin-profile-id
BUFFER_PROFILE_IDS_TWITTER=your-twitter-profile-id

# Posting time preferences (UTC)
LINKEDIN_OPTIMAL_HOURS=9,12,17
TWITTER_OPTIMAL_HOURS=8,12,16,20
BLOG_PUBLISH_HOUR=10

# Scheduler timezone
SCHEDULER_TIMEZONE=UTC
NEWS_SCAN_HOUR=6
CONTENT_GEN_HOUR=7

# Content settings
MAX_NEWS_ITEMS_PER_FEED=20
RAPID_RESPONSE_THRESHOLD=0.8  # Relevance score above which rapid response triggers
